<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hrmon.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python3.12</string>
        <string>/Users/Pothuri/Desktop/cc/hr-mon/scripts/daily.py</string>
    </array>
    <!-- Every day at 8:00 AM; if the Mac is asleep then, runs on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/Pothuri/Desktop/cc/hr-mon/logs/daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Pothuri/Desktop/cc/hr-mon/logs/daily.log</string>
</dict>
</plist>
